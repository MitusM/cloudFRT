# .env.example — шаблон upload-МС uploads (cloudFRT). cp .env.example .env
# Без .env сервис не стартует (fail-fast в index.js).

# --- Шина (RabbitMQ) ---
RABBIT_URL=amqp://guest:***@localhost:5672/
TIMED_OUT=15000

# --- Redis (общий с gateway: сессии, cookie 'sid') ---
REDIS_PORT=6379
REDIS_HOST=127.0.0.1
REDIS_FAMILY=4
# Пароль Redis — тот же, что в корневом .env gateway (сессии одинаковы).
REDIS_PASSWORD=

# --- upload-МС ---
PORT=7620
# Микросервисы, которые uploads вызывает по шине (ask): auth/users для прав, cache/render для инвалидации.
MICROSERVICES_NAME=auth,users,cache,render
# Должен совпадать с gateway core/action.js (иначе uploads не увидит admin-сессию).
SESSION_SECRET=

# --- Загрузка файлов (общий диск cloudFRT/images/) ---
UPLOAD_DIR=/images/
UPLOAD_FILESIZE=100*1024*1024
UPLOAD_MIMETYPE=image/jpeg,image/jpg,image/png,image/webp
