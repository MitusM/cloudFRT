# .env.example — шаблон конфигурации микросервиса maps (cloudFRT)
# cp .env.example .env && заполни. Без .env сервис не стартует (fail-fast в index.js).

# --- Шина (RabbitMQ) ---
RABBIT_URL=amqp://guest:***@localhost:5672/

# Таймаут RPC, мс
TIMED_OUT=15000

# --- OrientDB ---
ORIENTDB_HOST=localhost
ORIENTDB_PORT=2424
ORIENTDB_HTTPPORT=2480
ORIENTDB_USERNAME=misha
ORIENTDB_PASSWORD=***
ORIENTDB_NAME=cloudFRT
ORIENTDB_POOL=25

# --- Redis (кэш) ---
REDIS_PORT=6379
REDIS_HOST=127.0.0.1
REDIS_FAMILY=4
REDIS_PASSWORD=

# --- Приложение ---
APP_URL=https://cloud.frt.su

# --- Папка фото мест (Google) ---
TREK_PLACE_PHOTO_DIR=/media/04E0AC01E0ABF6D8/cloudFRT/microservices/maps/uploads/photos/google

# --- Ключ шифрования API-ключей ---
ENCRYPTION_KEY=__вставь-ключ__

# --- Google Places API key (ОПЦИОНАЛЬНО). Пусто = только OSM. Решение 14.08.2026. ---
GOOGLE_PLACES_API_KEY=

# --- Шаблоны рендера (в коде не используются, но присутствуют в исходном .env) ---
VIEW_DIR=/microservices/maps/view/html/
TEMPLATE_FILE=index.html

# --- Rate-limit и разрешённые домены (публичные эндпоинты карты: geocode/pois) ---
RL_WINDOW_MS=60000        # окно rate-limit (мс)
RL_GEOCODE_MAX=20         # макс запросов geocode / мин на IP (Дорогой Nominatim; ужмёно с 30 при вводе токена)
RL_POIS_MAX=60            # макс запросов pois / мин на IP
ALLOWED_ORIGINS=dev.frt.su,cloud.frt.su,localhost,127.0.0.1  # домены для Origin/Referer (через запятую)

# --- Токен для публичных гео-эндпоинтов (geocode/pois) HMAC+TTL ---
# Секрет подписи HMAC для публичных гео-эндпоинтов карты (geocode/pois).
# Обязателен: без него публичные гео-эндпоинты НЕ защищены токеном (fail-open).
# Приоритет: MAPS_TOKEN_SECRET; фолбэк — ENCRYPTION_KEY. Сгенерировать: openssl rand -hex 32
MAPS_TOKEN_SECRET=ЗАМЕНИ-НА-openssl-rand-hex-32
