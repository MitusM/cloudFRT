# .env.example — шаблон конфигурации микросервиса destinations (cloudFRT)
# cp .env.example .env && заполни. Без .env сервис не стартует (fail-fast в index.js).

# --- Шина (RabbitMQ) ---
RABBIT_URL=amqp://guest:***@localhost:5672/

# Таймаут RPC, мс
TIMED_OUT=15000

# --- OrientDB ---
ORIENTDB_HOST=localhost
ORIENTDB_PORT=2424
ORIENTDB_HTTPPORT=2480
ORIENTDB_USERNAME=misha
ORIENTDB_PASSWORD=***
ORIENTDB_NAME=cloudFRT
ORIENTDB_POOL=25

# --- Redis (кэш) ---
REDIS_PORT=6379
REDIS_HOST=127.0.0.1
REDIS_FAMILY=4
REDIS_PASSWORD=

# --- Приложение ---
APP_URL=https://cloud.frt.su

# --- Шаблоны рендера ---
VIEW_DIR=/microservices/destinations/view/html/
TEMPLATE_FILE=index.html
