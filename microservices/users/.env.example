# .env.example — шаблон конфигурации микросервиса users (cloudFRT)
# cp .env.example .env && заполни. Без .env сервис не стартует (fail-fast in index.js).

# --- Шина (RabbitMQ) ---
RABBIT_URL=amqp://guest:***@localhost:5672/

# Таймаут RPC, мс
TIMED_OUT=15000

# --- Шаблоны рендера ---
VIEW_DIR=/microservices/users/view/html/
TEMPLATE_FILE=index.html

# --- Соль (хэширование) ---
SALT=__сгенерируй-случайную-строку__

# --- OrientDB ---
ORIENTDB_HOST=localhost
ORIENTDB_PORT=2424
ORIENTDB_HTTPPORT=2480
ORIENTDB_USERNAME=misha
ORIENTDB_PASSWORD=***
ORIENTDB_NAME=cloudFRT
ORIENTDB_POOL=25
ORIENTDB_TABLENAME=User

# --- Redis (кэш) ---
REDIS_PORT=6379
REDIS_HOST=127.0.0.1
REDIS_FAMILY=4
REDIS_PASSWORD=

# --- Пользователи ---
USER_LIMIT=10
USER_QUOTA=5
CACHE=false
