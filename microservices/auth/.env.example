# .env.example — шаблон конфигурации микросервиса auth (cloudFRT)
# cp .env.example .env && заполни. Без .env сервис не стартует (fail-fast в index.js).

# --- Шина (RabbitMQ) ---
RABBIT_URL=amqp://guest:guest@localhost:5672/

# Таймаут RPC, мс
TIMED_OUT=15000

# --- Шаблоны рендера ---
VIEW_DIR=/microservices/auth/view/html/
TEMPLATE_FILE=index.html
