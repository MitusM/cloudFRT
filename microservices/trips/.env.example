# ============================================================================
# .env.example — шаблон конфигурации микросервиса trips (cloudFRT)
#
# Копия в .env (в той же папке) и заполни значения:
#   cp .env.example .env && nano .env
#
# Без .env сервис НЕ стартует — index.js делает fail-fast и сообщит,
# каких переменных не хватает.
# ============================================================================

# --- Шина микросервисов (RabbitMQ) ---
RABBIT_URL=amqp://guest:guest@localhost:5672/

# Таймаут RPC-запросов к другим микросервисам, мс
TIMED_OUT=15000

# --- Шаблоны рендера ---
VIEW_DIR=/microservices/trips/view/html/
TEMPLATE_FILE=index.html

# --- OrientDB ---
ORIENTDB_HOST=localhost
ORIENTDB_PORT=2424
ORIENTDB_HTTPPORT=2480
ORIENTDB_USERNAME=misha
ORIENTDB_PASSWORD=__CHANGE_ME__
ORIENTDB_NAME=cloudFRT
ORIENTDB_POOL=25
ORIENTDB_TABLENAME=Trip

# --- Redis (кэш) ---
REDIS_PORT=6379
REDIS_HOST=127.0.0.1
REDIS_FAMILY=4
REDIS_PASSWORD=

# --- Прочее ---
COVER_MAX_SIZE=20971520
