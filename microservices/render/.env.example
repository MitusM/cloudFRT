# .env.example — шаблон конфигурации микросервиса render (cloudFRT)
# render — рендер шаблонов (Nunjucks/подобное), сервис CommonJS.
# Не имеет fail-fast: RABBIT_URL имеет разумный дефолт, краша на импорте нет.
# cp .env.example .env (опционально — сервис работает и без .env).

# --- Шина (RabbitMQ) ---
RABBIT_URL=amqp://guest:***@localhost:5672/
