# .env.example — шаблон конфигурации микросервиса cache (cloudFRT)
# cp .env.example .env && заполни. Без .env сервис не стартует (fail-fast в index.js).

# --- Шина (RabbitMQ) ---
RABBIT_URL=amqp://guest:***@localhost:5672/

# Таймаут RPC, мс
TIMED_OUT=15000

# --- Шаблоны рендера ---
VIEW_DIR=/microservices/geo/view/html/
TEMPLATE_FILE=index.html

# --- Соль (хэширование) ---
SALT=__сгенерируй-случайную-строку__

# --- Redis (кэш) ---
REDIS_PORT=6379
REDIS_HOST=127.0.0.1
REDIS_FAMILY=4
REDIS_PASSWORD=

CACHE=false
