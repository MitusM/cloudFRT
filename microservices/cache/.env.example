# .env.example — шаблон конфигурации микросервиса cache (cloudFRT)
# cp .env.example .env && заполни. Без .env сервис не стартует (fail-fast в index.js).

# --- Шина (RabbitMQ) ---
RABBIT_URL=amqp://guest:***@localhost:5672/

# Таймаут RPC, мс
TIMED_OUT=15000

# --- Шаблоны рендера (fail-fast; фактически не рендерится — HTTP-эндпоинтов нет) ---
VIEW_DIR=/microservices/cache/view/html/

# --- Redis (кэш) ---
REDIS_PORT=6379
REDIS_HOST=127.0.0.1
REDIS_FAMILY=4
REDIS_PASSWORD=
