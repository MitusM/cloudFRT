# .env.example — шаблон конфигурации микросервиса geo (cloudFRT)
# cp .env.example .env && заполни. Без .env сервис не стартует (fail-fast в index.js).

# --- Шина (RabbitMQ) ---
RABBIT_URL=amqp://guest:***@localhost:5672/

# Таймаут RPC, мс
TIMED_OUT=15000

# --- Шаблоны рендера ---
VIEW_DIR=/microservices/geo/view/html/
TEMPLATE_FILE=index.html

# --- Соль (хэширование) ---
SALT=__сгенерируй-случайную-строку__

# --- СУБД: MySQL (необязательно) ---
MYSQL_HOST=localhost
MYSQL_PORT=
MYSQL_USER=misha
MYSQL_PASSWORD=***
MYSQL_DATABASE=geodata

# --- СУБД: PostgreSQL (основная для geo) ---
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=geodata
PG_USER=misha
PG_PASSWORD=***

# --- Sequelize (DIALECT выбирает СУБД: postgres | mysql) ---
DIALECT=postgres
HOST=localhost
PORT=5432
DATABASE=geodata
USER=misha
PASSWORD=***
POOL={max: 5, min: 0, acquire: 30000, idle: 10000}

# --- Redis (кэш) ---
REDIS_PORT=6379
REDIS_HOST=127.0.0.1
REDIS_FAMILY=4
REDIS_PASSWORD=

CACHE=false
